# MySQL connection. Adjust the URL/user for your local database.
MYSQL_URL=jdbc:mysql://localhost:3306/medicare_db?createDatabaseIfNotExist=true&sslMode=REQUIRED&serverTimezone=UTC
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Generate a fresh Base64 secret that decodes to at least 32 bytes.
MEDICARE_JWT_SECRET=replace-with-a-fresh-base64-secret

# Local AI service settings. Ollama must be installed and the model pulled separately.
MEDICARE_AI_AUTOSTART=true
MEDICARE_AI_HF_OFFLINE=true
MEDICARE_OLLAMA_URL=http://localhost:11434/api/chat
MEDICARE_OLLAMA_MODEL=qwen2.5:1.5b
MEDICARE_WHISPER_URL=http://localhost:8082/transcribe
MEDICARE_TROCR_URL=http://localhost:8081/ocr